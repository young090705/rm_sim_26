<?xml version="1.0"?>
<!--
  哨兵"烧饼"安装关系; publish_tf=true 时由 robot_state_publisher 发布 TF.
  joint 名与 model.sdf 一致.
  坐标: base_link 原点=大yaw轴心(CAD原点面高度, 轮心上方20mm), 地面 z=-0.096.
-->
<robot name="sentry">

  <link name="base_link"/>

  <!-- 底盘本体 -->
  <link name="chassis">
    <visual>
      <origin xyz="-0.0625 -0.0625 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://rm_sim_26/models/sentry/meshes/base_link.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 全向轮 x4 (轮系 z=轮轴, 沿径向朝外) -->
  <link name="wheel_fl_link">
    <visual>
      <geometry><mesh filename="package://rm_sim_26/models/sentry/meshes/omni_wheel.glb"/></geometry>
    </visual>
  </link>
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl_link"/>
    <origin xyz="0.1732 0.1732 -0.020" rpy="0 1.5708 0.7854"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_rl_link">
    <visual>
      <geometry><mesh filename="package://rm_sim_26/models/sentry/meshes/omni_wheel.glb"/></geometry>
    </visual>
  </link>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl_link"/>
    <origin xyz="-0.1732 0.1732 -0.020" rpy="0 1.5708 2.3562"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_rr_link">
    <visual>
      <geometry><mesh filename="package://rm_sim_26/models/sentry/meshes/omni_wheel.glb"/></geometry>
    </visual>
  </link>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr_link"/>
    <origin xyz="-0.1732 -0.1732 -0.020" rpy="0 1.5708 -2.3562"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_fr_link">
    <visual>
      <geometry><mesh filename="package://rm_sim_26/models/sentry/meshes/omni_wheel.glb"/></geometry>
    </visual>
  </link>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr_link"/>
    <origin xyz="0.1732 -0.1732 -0.020" rpy="0 1.5708 -0.7854"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- 大yaw回转层 -->
  <link name="gimbal_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://rm_sim_26/models/sentry/meshes/gimbal_link_structure.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="big_yaw_joint" type="continuous">
    <parent link="base_link"/>
    <child link="gimbal_link"/>
    <origin xyz="0 0 0.0845" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- 简化铝制短悬臂, 与SDF使用相同几何与估计惯量. -->
  <link name="lidar_mount_link">
    <inertial>
      <origin xyz="0.0986210301024 -0.029538666021 0.522034294653" rpy="0 0 0" />
      <mass value="0.356946740101" />
      <inertia ixx="0.00155461340212" ixy="0.000872224208629" ixz="0.000919113921551" iyy="0.00420495864451" iyz="-0.000275290160078" izz="0.00326410075803" />
    </inertial>
    <visual name="mount_foot_visual">
      <origin xyz="0.207 -0.062 0.354" rpy="0 0 0" />
      <geometry><box size="0.028 0.03 0.004" /></geometry>
      <material name="lidar_mount_aluminium"><color rgba="0.45 0.48 0.52 1" /></material>
    </visual>
    <collision name="mount_foot_collision">
      <origin xyz="0.207 -0.062 0.354" rpy="0 0 0" />
      <geometry><box size="0.028 0.03 0.004" /></geometry>
    </collision>
    <visual name="mount_post_visual">
      <origin xyz="0.207 -0.062 0.464" rpy="0 0 0" />
      <geometry><box size="0.012 0.014 0.216" /></geometry>
      <material name="lidar_mount_aluminium"><color rgba="0.45 0.48 0.52 1" /></material>
    </visual>
    <collision name="mount_post_collision">
      <origin xyz="0.207 -0.062 0.464" rpy="0 0 0" />
      <geometry><box size="0.012 0.014 0.216" /></geometry>
    </collision>
    <visual name="mount_arm_visual">
      <origin xyz="0.1035 -0.031 0.566" rpy="0 0 -0.291013532096" />
      <geometry><box size="0.216085631174 0.018 0.012" /></geometry>
      <material name="lidar_mount_aluminium"><color rgba="0.45 0.48 0.52 1" /></material>
    </visual>
    <collision name="mount_arm_collision">
      <origin xyz="0.1035 -0.031 0.566" rpy="0 0 -0.291013532096" />
      <geometry><box size="0.216085631174 0.018 0.012" /></geometry>
    </collision>
    <visual name="mount_spacer_visual">
      <origin xyz="0 0 0.545" rpy="0 0 0" />
      <geometry><box size="0.026 0.026 0.03" /></geometry>
      <material name="lidar_mount_aluminium"><color rgba="0.45 0.48 0.52 1" /></material>
    </visual>
    <collision name="mount_spacer_collision">
      <origin xyz="0 0 0.545" rpy="0 0 0" />
      <geometry><box size="0.026 0.026 0.03" /></geometry>
    </collision>
    <visual name="mount_plate_visual">
      <origin xyz="0 0 0.528" rpy="0 0 0" />
      <geometry><box size="0.08 0.08 0.004" /></geometry>
      <material name="lidar_mount_aluminium"><color rgba="0.45 0.48 0.52 1" /></material>
    </visual>
    <collision name="mount_plate_collision">
      <origin xyz="0 0 0.528" rpy="0 0 0" />
      <geometry><box size="0.08 0.08 0.004" /></geometry>
    </collision>
  </link>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="gimbal_link"/><child link="lidar_mount_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- MID360 水平倒置, 大yaw为0时+X与底盘+X同向; 外壳与扫描坐标系同步安装. -->
  <link name="livox_lidar">
    <visual name="housing">
      <origin xyz="-0.043315242828 -0.112534453377 -0.308285641154" rpy="1.211343044716 1.007311435550 1.152522436476"/>
      <geometry><mesh filename="package://rm_sim_26/models/sentry/meshes/mid360_housing.glb"/></geometry>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount_link"/>
    <child link="livox_lidar"/>
    <origin xyz="0 0 0.5000" rpy="3.141592653589793 0 0"/>
  </joint>

  <!-- 小yaw -->
  <link name="small_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://rm_sim_26/models/sentry/meshes/small_yaw_link.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="small_yaw_joint" type="revolute">
    <parent link="gimbal_link"/>
    <child link="small_yaw_link"/>
    <origin xyz="0 0.0585 0.1210" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="20"/>
  </joint>

  <!-- pitch 发射体 -->
  <link name="pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://rm_sim_26/models/sentry/meshes/pitch_link.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="pitch_joint" type="revolute">
    <parent link="small_yaw_link"/>
    <child link="pitch_link"/>
    <origin xyz="0 0 0.169" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.35" upper="0.55" effort="10" velocity="20"/>
  </joint>

  <!-- 自瞄 IMU (DM-IMU-L1, pitch体上) -->
  <link name="gimbal_imu"/>
  <joint name="gimbal_imu_joint" type="fixed">
    <parent link="pitch_link"/>
    <child link="gimbal_imu"/>
    <origin xyz="-0.0017 0.0055 0.0306" rpy="3.1416 0 1.5708"/>
  </joint>

  <!-- 自瞄相机安装点 (MV-CA016, pitch体上; 光轴朝向待自瞄组标定) -->
  <link name="camera_mount"/>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="pitch_link"/>
    <child link="camera_mount"/>
    <origin xyz="-0.0017 0.1395 0.0531" rpy="0 0 0"/>
  </joint>

</robot>
